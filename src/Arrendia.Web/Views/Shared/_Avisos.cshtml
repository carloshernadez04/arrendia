@if (TempData["Mensaje"] is string mensaje)
{
    <div class="aviso ok" role="status">@Iconos.Svg("check", "s")<span>@mensaje</span></div>
}
@if (TempData["Error"] is string error)
{
    <div class="aviso error" role="alert">@Iconos.Svg("alert", "s")<span>@error</span></div>
}
@if (TempData["Enlace"] is string enlace)
{
    <div class="aviso info copiar" role="status">
        @Iconos.Svg("mail", "s")
        <div class="col">
            <span>@(TempData["EnlaceTitulo"] as string ?? "Copia este enlace y envíaselo:")</span>
            <div class="row">
                <input class="inp mono" value="@enlace" readonly aria-label="Enlace" data-copiable />
                <button type="button" class="btn sm" data-copiar>Copiar</button>
            </div>
        </div>
    </div>
}
