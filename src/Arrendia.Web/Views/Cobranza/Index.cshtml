@model CobranzaModelo
@{
    ViewData["Title"] = "Cobranza";
    (int Valor, string Texto)[] tramos = [(0, "Todos con saldo"), (1, "Con atraso"), (31, "Más de 30 días"), (61, "Más de 60 días"), (91, "Más de 90 días")];
}
<div class="ph">
    <div>
        <h2>Cobranza</h2>
        <p class="muted">Contratos con saldo, ordenados por días de atraso.</p>
    </div>
</div>
<div class="kpis">
    <div class="kpi"><span>Por vencer</span><b>@Formato.Dinero(Model.Filas.Sum(f => f.PorVencer))</b></div>
    <div class="kpi"><span>1 a 30 días</span><b>@Formato.Dinero(Model.Filas.Sum(f => f.De1A30))</b></div>
    <div class="kpi"><span>31 a 60 días</span><b>@Formato.Dinero(Model.Filas.Sum(f => f.De31A60))</b></div>
    <div class="kpi"><span>61 a 90 días</span><b>@Formato.Dinero(Model.Filas.Sum(f => f.De61A90))</b></div>
    <div class="kpi malo"><span>Más de 90 días</span><b>@Formato.Dinero(Model.Filas.Sum(f => f.MasDe90))</b></div>
</div>
<form method="get" class="toolbar">
    <select name="dias" class="sel" aria-label="Atraso">
        @foreach (var (valor, texto) in tramos) { <option value="@valor" selected="@(valor == Model.MinimoDias)">@texto</option> }
    </select>
    <select name="propiedad" class="sel" aria-label="Propiedad">
        <option value="">Todas las propiedades</option>
        @foreach (var p in Model.Propiedades) { <option value="@p.Id" selected="@(p.Id == Model.PropiedadId)">@p.Nombre</option> }
    </select>
    <button type="submit" class="btn">Filtrar</button>
</form>
<section class="card">
    @if (Model.Filas.Count == 0)
    {
        <div class="vacio">@Iconos.Svg("check", "xl")<b>Nadie debe en este tramo</b><span>Todos los contratos están al día.</span></div>
    }
    else
    {
        <div class="tw">
            <table class="tbl">
                <thead><tr><th>Contrato</th><th>Contacto</th><th class="r">Atraso</th><th class="r">1-30</th><th class="r">31-60</th><th class="r">61-90</th><th class="r">+90</th><th class="r">Vencido</th></tr></thead>
                <tbody>
                    @foreach (var f in Model.Filas)
                    {
                        <tr>
                            <td data-l="Contrato"><a class="mono enlace-fila" href="/contratos/@f.ContratoId">@f.Numero</a><small class="muted bloque">@f.Inquilino · @f.Unidad, @f.Propiedad</small></td>
                            <td data-l="Contacto">@if (f.Telefono is not null) { <a class="mono" href="tel:@f.Telefono">@f.Telefono</a> }<small class="muted bloque">@f.Email</small></td>
                            <td data-l="Atraso" class="r num"><span class="chip @(f.MaxDiasAtraso > 60 ? "bad" : f.MaxDiasAtraso > 0 ? "warn" : "")">@f.MaxDiasAtraso días</span></td>
                            <td data-l="1-30" class="r num">@Formato.Dinero(f.De1A30)</td>
                            <td data-l="31-60" class="r num">@Formato.Dinero(f.De31A60)</td>
                            <td data-l="61-90" class="r num">@Formato.Dinero(f.De61A90)</td>
                            <td data-l="+90" class="r num">@Formato.Dinero(f.MasDe90)</td>
                            <td data-l="Vencido" class="r num"><b>@Formato.Dinero(f.Vencido)</b>@if (f.MoraPendiente > 0) { <small class="muted bloque">@Formato.Dinero(f.MoraPendiente) de mora</small> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
