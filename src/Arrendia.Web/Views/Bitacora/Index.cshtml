@model BitacoraModelo
@{
    ViewData["Title"] = "Bitácora";
    var f = Model.Filtro;
}
<div class="ph">
    <div>
        <h2>Bitácora</h2>
        <p class="muted">Quién hizo qué y cuándo. No se puede modificar ni borrar.</p>
    </div>
</div>
<form method="get" class="toolbar">
    <select name="tabla" class="sel" aria-label="Tabla">
        <option value="">Todas las tablas</option>
        @foreach (var t in Model.Tablas) { <option value="@t" selected="@(t == f.Tabla)">@t</option> }
    </select>
    <select name="usuario" class="sel" aria-label="Usuario">
        <option value="">Todos los usuarios</option>
        @foreach (var u in Model.Usuarios) { <option value="@u.Id" selected="@(u.Id == f.UsuarioId)">@u.Nombre</option> }
    </select>
    <input name="accion" class="inp corto" value="@f.Accion" placeholder="Acción" aria-label="Acción" />
    <label class="campo-filtro"><span>Desde</span><input name="desde" type="date" class="inp" value="@f.Desde?.ToString("yyyy-MM-dd")" /></label>
    <label class="campo-filtro"><span>Hasta</span><input name="hasta" type="date" class="inp" value="@f.Hasta?.ToString("yyyy-MM-dd")" /></label>
    <button type="submit" class="btn">Filtrar</button>
</form>
<section class="card">
    @if (Model.Filas.Count == 0)
    {
        <div class="vacio"><span>Sin registros con este filtro.</span></div>
    }
    else
    {
        <div class="tw">
            <table class="tbl">
                <thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Registro</th><th>Detalle</th></tr></thead>
                <tbody>
                    @foreach (var b in Model.Filas)
                    {
                        <tr>
                            <td data-l="Fecha">@Formato.FechaHora(b.FechaCreacion)</td>
                            <td data-l="Usuario">@(b.Usuario ?? "Sistema")</td>
                            <td data-l="Acción"><b>@b.Accion</b></td>
                            <td data-l="Registro" class="mono">@b.Tabla @b.RegistroId</td>
                            <td data-l="Detalle" class="mono detalle">@b.Detalle</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <partial name="_Paginacion" model="Model.Paginacion" />
</section>
<section class="card espacio">
    <div class="hd"><h3>Procesos automáticos</h3><span class="muted">Generación de rentas y cálculo de mora (corren cada hora y se ponen al día solos)</span></div>
    <div class="tw">
        <table class="tbl">
            <thead><tr><th>Proceso</th><th>Día procesado</th><th>Inicio</th><th class="r">Registros</th><th>Estado</th></tr></thead>
            <tbody>
                @foreach (var e in Model.Ejecuciones)
                {
                    <tr>
                        <td data-l="Proceso">@(e.Proceso == "GenerarCargos" ? "Generar rentas" : "Calcular mora")</td>
                        <td data-l="Día">@Formato.Fecha(e.FechaProceso)</td>
                        <td data-l="Inicio">@Formato.FechaHora(e.Inicio)</td>
                        <td data-l="Registros" class="r num">@e.Registros</td>
                        <td data-l="Estado"><span class="chip @Estados.Clase(e.Estado)">@e.Estado</span>@if (e.Error is not null) { <small class="bloque malo">@e.Error</small> }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
