@{
    var nombre = User.Identity?.Name ?? "";
    var ruta = Context.Request.Path.Value ?? "";
    string? Actual(string prefijo) => prefijo == "/portal" ? (ruta is "/portal" or "/portal/" ? "page" : null) : (ruta.StartsWith(prefijo, StringComparison.OrdinalIgnoreCase) ? "page" : null);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <partial name="_Cabecera" />
    @await RenderSectionAsync("Cabecera", required: false)
    <title>@(ViewData["Title"] is string t ? $"{t} · Arrendia" : "Arrendia")</title>
</head>
<body>
    <div class="portal">
        <header class="portal-top">
            @Iconos.Logo<b class="marca">Arrendia</b>
            <nav class="portal-nav" aria-label="Secciones">
                <a href="/portal" aria-current="@Actual("/portal")">Inicio</a>
                <a href="/portal/pagar" aria-current="@Actual("/portal/pag")">Pagar</a>
                <a href="/portal/documentos" aria-current="@Actual("/portal/documentos")">Documentos</a>
                <a href="/portal/reportes" aria-current="@Actual("/portal/reportes")">Reportes</a>
            </nav>
            <span class="grow"></span>
            <partial name="_BotonTema" />
            <div class="rel">
                <button type="button" class="av" data-pop aria-haspopup="menu" aria-label="Cuenta">@Navegacion.Iniciales(nombre)</button>
                <div class="pop" role="menu">
                    <div class="pop-h"><b>@nombre</b><span class="muted">@User.FindFirstValue(ClaimTypes.Email)</span></div>
                    <a class="it" role="menuitem" href="/mi-cuenta">@Iconos.Svg("users", "s") Mi cuenta</a>
                    <form method="post" asp-controller="Cuenta" asp-action="Salir">
                        <button type="submit" class="it" role="menuitem">@Iconos.Svg("logout", "s") Cerrar sesión</button>
                    </form>
                </div>
            </div>
        </header>
        <main class="portal-main" id="vista">
            @RenderBody()
        </main>
        <nav class="portal-barra" aria-label="Secciones">
            <a href="/portal" aria-current="@Actual("/portal")">@Iconos.Svg("home")Inicio</a>
            <a href="/portal/pagar" aria-current="@Actual("/portal/pag")">@Iconos.Svg("card")Pagar</a>
            <a href="/portal/documentos" aria-current="@Actual("/portal/documentos")">@Iconos.Svg("file")Documentos</a>
            <a href="/portal/reportes" aria-current="@Actual("/portal/reportes")">@Iconos.Svg("wrench")Reportes</a>
        </nav>
    </div>
</body>
</html>
