@model UnidadesModelo
@{
    ViewData["Title"] = "Unidades";
    var f = Model.Filtro;
}
<partial name="_Avisos" />
<div class="ph">
    <div>
        <h2>Unidades</h2>
        <p class="muted">Locales, apartamentos y oficinas de tus propiedades.</p>
    </div>
</div>
<form method="get" class="toolbar" role="search">
    <div class="buscar">@Iconos.Svg("search", "s")<input name="buscar" class="inp" value="@f.Buscar" placeholder="Código, propiedad o inquilino" aria-label="Buscar" /></div>
    <select name="propiedad" class="sel" aria-label="Propiedad">
        <option value="">Todas las propiedades</option>
        @foreach (var p in Model.Propiedades) { <option value="@p.Id" selected="@(p.Id == f.PropiedadId)">@p.Nombre</option> }
    </select>
    <select name="estado" class="sel" aria-label="Estado">
        <option value="">Todos los estados</option>
        @foreach (var e in Catalogos.EstadosUnidad) { <option value="@e" selected="@(e == f.Estado)">@Catalogos.TextoEstado(e)</option> }
    </select>
    <select name="tipo" class="sel" aria-label="Tipo">
        <option value="">Todos los tipos</option>
        @foreach (var t in Model.Tipos) { <option value="@t.Id" selected="@(t.Id == f.TipoUnidadId)">@t.Nombre</option> }
    </select>
    <button type="submit" class="btn">Filtrar</button>
</form>
<section class="card">
    @if (Model.Unidades.Count == 0)
    {
        <div class="vacio">
            @Iconos.Svg("search", "xl")
            <b>No hay unidades con este filtro</b>
            <span>Prueba con otra búsqueda o agrega unidades desde la propiedad.</span>
        </div>
    }
    else
    {
        <div class="tw">
            <table class="tbl">
                <thead><tr><th>Unidad</th><th>Tipo</th><th class="r">Área</th><th class="r">Renta de referencia</th><th>Estado</th><th>Inquilino</th></tr></thead>
                <tbody>
                    @foreach (var u in Model.Unidades)
                    {
                        <tr>
                            <td data-l="Unidad"><a class="mono enlace-fila" asp-controller="Propiedades" asp-action="Detalle" asp-route-id="@u.PropiedadId">@u.Codigo</a><small class="muted bloque">@u.Propiedad</small></td>
                            <td data-l="Tipo">@u.TipoUnidad</td>
                            <td data-l="Área" class="r num">@Formato.Area(u.AreaM2)</td>
                            <td data-l="Renta" class="r num">@Formato.Dinero(u.RentaReferencia)</td>
                            <td data-l="Estado"><span class="chip @Catalogos.ClaseEstado(u.Estado)">@Catalogos.TextoEstado(u.Estado)</span>@if (u.ConAtraso) { <span class="chip bad">Con atraso</span> }</td>
                            <td data-l="Inquilino">@(u.Inquilino ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pie-tabla muted">@Model.Unidades.Count @(Model.Unidades.Count == 1 ? "unidad" : "unidades")</div>
    }
</section>
