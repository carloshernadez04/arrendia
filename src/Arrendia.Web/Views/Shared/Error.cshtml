@model string
@{
    ViewData["Title"] = "Algo salió mal";
    Layout = "_LayoutAcceso";
    var codigo = Context.Response.StatusCode;
}
<div class="mensaje">
    <span class="sello alerta">@Iconos.Svg("alert", "l")</span>
    @if (codigo == 404)
    {
        <h1>No encontramos esta página</h1>
        <p class="muted">Revisa la dirección o vuelve al inicio.</p>
    }
    else if (codigo == 429)
    {
        <h1>Demasiados intentos</h1>
        <p class="muted">Espera un minuto y vuelve a intentarlo.</p>
    }
    else
    {
        <h1>Algo salió mal</h1>
        <p class="muted">No pudimos completar la acción. Inténtalo de nuevo en un momento.</p>
        <p class="hint">Código de seguimiento: <span class="mono">@Model</span></p>
    }
    <a class="btn pri blk" href="/">Volver al inicio</a>
</div>
