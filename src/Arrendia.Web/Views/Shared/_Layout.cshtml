@{
    var nombre = User.Identity?.Name ?? "";
    var rol = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var ruta = Context.Request.Path.Value ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <partial name="_Cabecera" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Arrendia" : "Arrendia")</title>
</head>
<body>
    <div class="shell" data-shell>
        <aside class="side" aria-label="Menú principal">
            <div class="brand">@Iconos.Logo<b>Arrendia</b></div>
            <nav class="nav">
                @foreach (var grupo in Navegacion.Para(User))
                {
                    <div class="ngrp">@grupo.Titulo</div>
                    @foreach (var e in grupo.Elementos)
                    {
                        if (e.Ruta is null)
                        {
                            <span class="nl off" title="Se construye en un próximo módulo">@Iconos.Svg(e.Icono)<span class="t">@e.Texto</span><span class="pronto">Pronto</span></span>
                        }
                        else
                        {
                            <a class="nl" href="@e.Ruta" aria-current="@(ruta.StartsWith(e.Ruta, StringComparison.OrdinalIgnoreCase) ? "page" : null)">@Iconos.Svg(e.Icono)<span class="t">@e.Texto</span></a>
                        }
                    }
                }
            </nav>
        </aside>
        <div class="velo" data-cerrar-menu></div>
        <div class="main">
            <header class="top">
                <button type="button" class="btn ghost icon burger" data-abrir-menu aria-label="Abrir menú">@Iconos.Svg("menu")</button>
                <h1 class="titulo">@ViewData["Title"]</h1>
                <span class="grow"></span>
                <partial name="_BotonTema" />
                <div class="rel">
                    <button type="button" class="av" data-pop aria-haspopup="menu" aria-label="Cuenta">@Navegacion.Iniciales(nombre)</button>
                    <div class="pop" role="menu">
                        <div class="pop-h"><b>@nombre</b><span class="muted">@rol · @User.FindFirstValue(ClaimTypes.Email)</span></div>
                        <form method="post" asp-controller="Cuenta" asp-action="Salir">
                            <button type="submit" class="it" role="menuitem">@Iconos.Svg("logout", "s") Cerrar sesión</button>
                        </form>
                    </div>
                </div>
            </header>
            <main id="vista">
                @RenderBody()
            </main>
        </div>
    </div>
</body>
</html>
