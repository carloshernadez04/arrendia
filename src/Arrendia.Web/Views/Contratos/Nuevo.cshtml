@model ContratoFormulario
@{
    ViewData["Title"] = "Nuevo contrato";
    var porPropiedad = Model.Unidades.GroupBy(u => u.Propiedad);
}
<div class="ph">
    <div>
        <h2>Nuevo contrato</h2>
        <p class="muted">Se crea en borrador. Después generas el PDF, lo firman y lo activas subiendo el escaneado.</p>
    </div>
</div>
@if (Model.Unidades.Count == 0 || Model.Inquilinos.Count == 0)
{
    <div class="aviso error" role="alert">@Iconos.Svg("alert", "s")<span>@(Model.Unidades.Count == 0 ? "No hay unidades disponibles en tus propiedades." : "No hay inquilinos activos. Registra uno primero.")</span></div>
}
<form method="post" class="card formulario" novalidate data-formulario>
    <div asp-validation-summary="All" class="aviso error"></div>
    <div class="campos">
        <div class="fld ancho">
            <label asp-for="UnidadId"></label>
            <select asp-for="UnidadId" class="sel" data-sugerir="Renta">
                <option value="">Elige una unidad disponible</option>
                @foreach (var g in porPropiedad)
                {
                    <optgroup label="@g.Key">
                        @foreach (var u in g)
                        {
                            <option value="@u.Id" data-valor="@(u.RentaReferencia?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" selected="@(u.Id == Model.UnidadId)">@u.Codigo · @u.TipoUnidad@(u.RentaReferencia is null ? "" : $" · {Formato.Dinero(u.RentaReferencia)}")</option>
                        }
                    </optgroup>
                }
            </select>
        </div>
        <div class="fld ancho">
            <label asp-for="InquilinoId"></label>
            <select asp-for="InquilinoId" class="sel" asp-items="@(new SelectList(Model.Inquilinos, "Id", "Nombre"))">
                <option value="">Elige el inquilino</option>
            </select>
            <span class="hint">¿No aparece? <a href="/inquilinos/nuevo">Registra un inquilino nuevo</a>.</span>
        </div>
        <div class="fld">
            <label asp-for="FechaInicio"></label>
            <input asp-for="FechaInicio" type="date" class="inp" />
        </div>
        <div class="fld">
            <label asp-for="FechaFin"></label>
            <input asp-for="FechaFin" type="date" class="inp" />
        </div>
        <div class="fld">
            <label asp-for="Renta"></label>
            <div class="pre"><span>$</span><input asp-for="Renta" type="number" step="0.01" min="0.01" class="inp num" inputmode="decimal" /></div>
            <span class="hint">El IVA se suma solo si la unidad lo aplica.</span>
        </div>
        <div class="fld">
            <label asp-for="MontoDeposito"></label>
            <div class="pre"><span>$</span><input asp-for="MontoDeposito" type="number" step="0.01" min="0" class="inp num" inputmode="decimal" /></div>
        </div>
        <div class="fld ancho">
            <label asp-for="PlantillaId"></label>
            <select asp-for="PlantillaId" class="sel">
                @foreach (var p in Model.Plantillas)
                {
                    <option value="@p.Id" selected="@(p.Id == Model.PlantillaId)">@p.Nombre · paga el día @p.DiaPago · @(p.AplicaMora ? $"mora {Formato.Porcentaje(p.PorcentajeMoraDiario)} diario tras {p.DiasGracia} días" : "sin mora")</option>
                }
            </select>
        </div>
        <details class="fld ancho ayuda">
            <summary>Personalizar las condiciones de este contrato</summary>
            <p>Deja en blanco lo que quieras tomar de la plantilla.</p>
            <div class="campos-internos">
                <div class="fld"><label asp-for="DiaPago">Día de pago</label><input asp-for="DiaPago" type="number" min="1" max="31" class="inp num" placeholder="Según la plantilla" /></div>
                <div class="fld"><label asp-for="DiasGracia">Días de gracia</label><input asp-for="DiasGracia" type="number" min="0" max="60" class="inp num" placeholder="Según la plantilla" /></div>
                <div class="fld"><label asp-for="PorcentajeMora">Mora diaria (%)</label><input asp-for="PorcentajeMora" type="number" min="0" max="5" step="0.0001" class="inp num" placeholder="Según la plantilla" /></div>
                <div class="fld">
                    <label asp-for="AplicaMora">Cobrar mora</label>
                    <select asp-for="AplicaMora" class="sel"><option value="">Según la plantilla</option><option value="si">Sí</option><option value="no">No</option></select>
                </div>
                <div class="fld">
                    <label asp-for="PermiteParciales">Pagos parciales</label>
                    <select asp-for="PermiteParciales" class="sel"><option value="">Según la plantilla</option><option value="si">Se permiten</option><option value="no">No se permiten</option></select>
                </div>
            </div>
        </details>
    </div>
    <div class="pie">
        <a class="btn" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn pri">Crear contrato</button>
    </div>
</form>
